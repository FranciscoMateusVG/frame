<p class="crumb"><a href="/orders">Voltar para Pedidos</a></p>

<article class="ticket" aria-labelledby="ticket-ref">
  <header class="ticket__head">
    <h1 id="ticket-ref" class="ticket__ref"><%= @order["reference"] %></h1>
    <p class="ticket__title"><%= @order["title"] %></p>
    <dl class="facts">
      <div><dt>Situação</dt><dd><span class="status status--<%= @order["status"] %>"><%= status_label(@order["status"]) %></span></dd></div>
      <div><dt>Revisão</dt><dd><%= @order["revision"] %></dd></div>
      <div><dt>Cópias no total</dt><dd><%= total_copies(@order) %></dd></div>
      <div><dt>Criado em</dt><dd><%= local_time(@order["createdAt"]) %></dd></div>
      <%= if @order["collectedAt"] do %><div><dt>Retirado em</dt><dd><%= local_time(@order["collectedAt"]) %></dd></div><% end %>
      <%= if @order["printedAt"] do %><div><dt>Impresso em</dt><dd><%= local_time(@order["printedAt"]) %></dd></div><% end %>
    </dl>
  </header>

  <%= if @order["status"] != "cancelled" do %>
  <ol class="track" aria-label="Etapas do pedido">
    <%= for {label, state} <- steps(@order) do %><li class="track__step track__step--<%= state %>"<%= if state == :current do %> aria-current="step"<% end %>><%= label %></li>
    <% end %>
  </ol>
  <% end %>

  <%= case @notice do %>
  <% {:ok, text} -> %><p class="notice notice--ok" role="status"><%= text %></p>
  <% {:error, text} -> %><p class="notice notice--error" role="alert"><%= text %></p>
  <% nil -> %>
  <% end %>

  <section class="jobs" aria-labelledby="jobs-title">
    <h2 id="jobs-title">Arquivos e instruções da revisão <%= @order["revision"] %></h2>
    <ul class="jobs__list">
      <%= for job <- @order["jobs"] do %>
      <li class="job">
        <div class="job__head">
          <h3 class="job__title"><%= job["title"] %></h3>
          <p class="job__copies"><strong><%= job["copies"] %></strong> <%= if job["copies"] == 1 do %>cópia<% else %>cópias<% end %></p>
        </div>
        <p class="job__instructions"><%= job["instructions"] %></p>
        <p class="job__file">
          <span class="job__filename"><%= job["file"]["name"] %></span>
          <span class="job__size"><%= file_size(job["file"]["bytes"]) %></span>
          <a class="button button--small" href="/api/print/v1/orders/<%= @order["id"] %>/files/<%= job["file"]["id"] %>" download>Baixar arquivo</a>
        </p>
      </li>
      <% end %>
    </ul>
  </section>

  <section class="panel" aria-labelledby="panel-title">
  <%= case next_action(@order) do %>
  <% :collect -> %>
    <h2 id="panel-title">Retirada dos arquivos</h2>
    <p>Baixe e confira todos os arquivos acima. Depois confirme a retirada — baixar sozinho não confirma nada.</p>
    <form method="post" action="/orders/<%= @order["id"] %>/collected" class="stack">
      <input type="hidden" name="_csrf" value="<%= @nav.csrf %>">
      <input type="hidden" name="if_match" value="<%= @etag %>">
      <input type="hidden" name="idempotency_key" value="<%= @key %>">
      <input type="hidden" name="revision" value="<%= @order["revision"] %>">
      <label class="check"><input type="checkbox" name="conferi" value="on" required> Conferi todos os arquivos desta revisão</label>
      <div class="actions">
        <button type="button" class="button button--primary" data-confirm="confirm-collect">Arquivos retirados</button>
        <noscript><button type="submit" class="button button--primary">Confirmar retirada</button></noscript>
      </div>
      <dialog id="confirm-collect" class="confirm" aria-labelledby="confirm-collect-title">
        <h3 id="confirm-collect-title">Confirmar retirada</h3>
        <p>Você confirma que retirou os <%= length(@order["jobs"]) %> arquivos da revisão <%= @order["revision"] %> de <%= @order["reference"] %>?</p>
        <div class="actions">
          <button type="submit" class="button button--primary">Confirmar retirada</button>
          <button type="button" class="button" data-close>Voltar</button>
        </div>
      </dialog>
    </form>
  <% action when action in [:quote, :requote] -> %>
    <%= if action == :requote do %>
      <h2 id="panel-title">Orçamento rejeitado</h2>
      <p class="notice notice--error"><strong>Motivo do Financeiro:</strong> <%= @order["currentQuote"]["rejectionReason"] || "não informado" %></p>
      <p>Envie um novo orçamento. O anterior fica guardado no histórico.</p>
    <% else %>
      <h2 id="panel-title">Orçamento</h2>
      <p>Informe o valor e anexe o orçamento (PDF, JPEG, PNG ou WebP, até 5 MB).</p>
    <% end %>
    <form method="post" action="/orders/<%= @order["id"] %>/quotes" enctype="multipart/form-data" class="stack">
      <input type="hidden" name="_csrf" value="<%= @nav.csrf %>">
      <input type="hidden" name="if_match" value="<%= @etag %>">
      <input type="hidden" name="idempotency_key" value="<%= @key %>">
      <input type="hidden" name="revision" value="<%= @order["revision"] %>">
      <label class="field">
        <span class="field__label">Valor do orçamento</span>
        <span class="money"><span class="money__prefix" aria-hidden="true">R$</span><input type="text" name="valor" inputmode="decimal" autocomplete="off" placeholder="0,00" value="<%= @amount %>" pattern="[0-9.]*[0-9](,[0-9]{1,2})?" required data-echo="quote-amount"></span>
      </label>
      <label class="field">
        <span class="field__label">Arquivo do orçamento</span>
        <input type="file" name="file" accept="application/pdf,image/jpeg,image/png,image/webp" required>
      </label>
      <div class="actions">
        <button type="button" class="button button--primary" data-confirm="confirm-quote"><%= if action == :requote do %>Enviar novo orçamento<% else %>Enviar orçamento<% end %></button>
        <noscript><button type="submit" class="button button--primary">Confirmar envio</button></noscript>
      </div>
      <dialog id="confirm-quote" class="confirm" aria-labelledby="confirm-quote-title">
        <h3 id="confirm-quote-title">Confirmar envio</h3>
        <p>Enviar orçamento de <strong>R$ <span data-echo-target="quote-amount"></span></strong> para <%= @order["reference"] %>, revisão <%= @order["revision"] %>?</p>
        <div class="actions">
          <button type="submit" class="button button--primary">Confirmar envio</button>
          <button type="button" class="button" data-close>Voltar</button>
        </div>
      </dialog>
    </form>
  <% :await_decision -> %>
    <h2 id="panel-title">Aguardando aprovação do Financeiro</h2>
    <p>Orçamento de <strong><%= money(@order["currentQuote"]["amountCents"]) %></strong> enviado em <%= local_time(@order["currentQuote"]["submittedAt"]) %>. Você será liberado para imprimir quando o Financeiro aprovar.</p>
    <p><a class="button button--small" href="/api/print/v1/orders/<%= @order["id"] %>/quotes/<%= @order["currentQuote"]["id"] %>/file" download>Baixar orçamento</a></p>
  <% :print -> %>
    <h2 id="panel-title">Orçamento aprovado</h2>
    <p>Valor aprovado: <strong><%= money(@order["currentQuote"]["amountCents"]) %></strong>. Imprima e depois confirme aqui.</p>
    <form method="post" action="/orders/<%= @order["id"] %>/printed" class="stack">
      <input type="hidden" name="_csrf" value="<%= @nav.csrf %>">
      <input type="hidden" name="if_match" value="<%= @etag %>">
      <input type="hidden" name="idempotency_key" value="<%= @key %>">
      <input type="hidden" name="revision" value="<%= @order["revision"] %>">
      <input type="hidden" name="quote_id" value="<%= @order["currentQuote"]["id"] %>">
      <div class="actions">
        <button type="button" class="button button--primary" data-confirm="confirm-print">Marcar como impresso</button>
        <noscript><button type="submit" class="button button--primary">Confirmar impressão</button></noscript>
      </div>
      <dialog id="confirm-print" class="confirm" aria-labelledby="confirm-print-title">
        <h3 id="confirm-print-title">Confirmar impressão</h3>
        <p>Confirma que <%= @order["reference"] %> (revisão <%= @order["revision"] %>) foi impresso? Esta confirmação não pode ser desfeita pelo portal.</p>
        <div class="actions">
          <button type="submit" class="button button--primary">Confirmar impressão</button>
          <button type="button" class="button" data-close>Voltar</button>
        </div>
      </dialog>
    </form>
  <% :none -> %>
    <%= if @order["status"] == "cancelled" do %>
      <h2 id="panel-title">Pedido cancelado</h2>
      <p><strong>Motivo:</strong> <%= @order["cancellationReason"] || "não informado" %></p>
      <p>Se você já retirou os arquivos, descarte as cópias deste pedido.</p>
    <% else %>
      <h2 id="panel-title">Impresso</h2>
      <p>Impressão confirmada em <%= local_time(@order["printedAt"]) %>. Valor aprovado: <strong><%= money(@order["approvedAmountCents"]) %></strong>. O pedido entra na nota fiscal do mês.</p>
    <% end %>
  <% end %>
  </section>
</article>
