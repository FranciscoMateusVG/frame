<section>
  <div class="heading">
    <h1>Notas fiscais</h1>
    <form method="get" action="/invoices" class="filters">
      <label class="field field--inline">
        <span class="field__label">Competência</span>
        <select name="competencia">
          <%= for c <- @competences do %><option value="<%= competence_value(c) %>"<%= if c == @competence do %> selected<% end %>><%= competence_label(c) %></option>
          <% end %>
        </select>
      </label>
      <button type="submit" class="button">Consultar</button>
    </form>
  </div>

  <p class="lede">Uma NF por mês, com todos os pedidos impressos naquele mês. A NF de <%= competence_label(@competence) %> pode ser enviada a partir de <%= opens_on(@competence) %>.</p>

  <%= case @notice do %>
  <% {:ok, text} -> %><p class="notice notice--ok" role="status"><%= text %></p>
  <% {:error, text} -> %><p class="notice notice--error" role="alert"><%= text %></p>
  <% nil -> %>
  <% end %>

  <%= case @result do %>
  <% :not_available -> %>
    <div class="empty">
      <p class="empty__title">Notas fiscais ainda indisponíveis.</p>
      <p>O envio de NF pelo portal ainda não foi liberado pelo Incluir. Os pedidos continuam funcionando normalmente.</p>
    </div>
  <% :unavailable -> %>
    <div class="notice notice--error" role="alert">
      <p>Não foi possível consultar o fechamento agora. O sistema do Incluir não respondeu.</p>
      <p><a class="button" href="/invoices?competencia=<%= competence_value(@competence) %>">Consultar novamente</a></p>
    </div>
  <% {:ok, close} -> %>
    <div class="close">
      <dl class="facts">
        <div><dt>Competência</dt><dd><%= competence_label(@competence) %></dd></div>
        <div><dt>Situação</dt><dd><span class="status status--close-<%= close["state"] %>"><%= close_label(close["state"]) %></span></dd></div>
        <div><dt>Total calculado</dt><dd class="amount"><%= money(close["expectedTotalCents"]) %></dd></div>
        <%= if close["declaredTotalCents"] do %><div><dt>Valor total da NF</dt><dd class="amount<%= if divergent?(close) do %> amount--diverges<% end %>"><%= money(close["declaredTotalCents"]) %></dd></div><% end %>
      </dl>

      <%= if divergent?(close) do %>
      <p class="notice notice--warn">O valor declarado na NF é diferente do total calculado pelos orçamentos aprovados. O Financeiro só aceita a NF com o mesmo valor.</p>
      <% end %>

      <%= if close["items"] == [] do %>
        <div class="empty"><p class="empty__title">Nenhum pedido impresso em <%= competence_label(@competence) %>.</p></div>
      <% else %>
      <table class="orders">
        <thead><tr><th scope="col">Pedido</th><th scope="col">Impresso em</th><th scope="col" class="num">Orçamento aprovado</th></tr></thead>
        <tbody>
        <%= for item <- close["items"] do %>
          <tr>
            <td class="orders__ref" data-label="Pedido"><a href="/orders/<%= item["orderId"] %>"><%= item["reference"] %></a></td>
            <td data-label="Impresso em"><%= local_time(item["printedAt"]) %></td>
            <td class="num" data-label="Orçamento aprovado"><%= money(item["amountCents"]) %></td>
          </tr>
        <% end %>
        </tbody>
        <tfoot><tr><th scope="row" colspan="2">Total calculado</th><td class="num"><%= money(close["expectedTotalCents"]) %></td></tr></tfoot>
      </table>
      <% end %>

      <%= if close["document"] do %>
      <p class="job__file"><span class="job__filename"><%= close["document"]["name"] %></span> <span class="job__size"><%= file_size(close["document"]["bytes"]) %></span>
        <a class="button button--small" href="/api/print/v1/monthly-closes/<%= close["competence"] %>/invoice" download>Baixar NF enviada</a></p>
      <% end %>

      <%= case @submission do %>
      <% :period_open -> %>
        <p class="notice notice--warn">O mês ainda não terminou. O envio da NF abre em <%= opens_on(@competence) %>.</p>
      <% :empty -> %>
      <% :already_submitted -> %>
        <p class="notice notice--wait">Aguardando conferência do Financeiro. Enviada em <%= local_time(close["submittedAt"]) %>.</p>
      <% :accepted -> %>
        <p class="notice notice--ok">NF aceita pelo Financeiro em <%= local_time(close["acceptedAt"]) %>.</p>
      <% :ok -> %>
        <%= if close["state"] == "rejected" do %>
        <p class="notice notice--error"><strong>NF rejeitada.</strong> Motivo: <%= close["rejectionReason"] || "não informado" %>. Envie uma nova NF.</p>
        <% end %>
        <form method="post" action="/invoices/<%= close["competence"] %>" enctype="multipart/form-data" class="stack panel">
          <h2>Enviar NF de <%= competence_label(@competence) %></h2>
          <input type="hidden" name="_csrf" value="<%= @nav.csrf %>">
          <input type="hidden" name="if_match" value="<%= Frame.Domain.Close.etag(close) %>">
          <input type="hidden" name="idempotency_key" value="<%= @key %>">
          <label class="field">
            <span class="field__label">Valor total da NF</span>
            <span class="money"><span class="money__prefix" aria-hidden="true">R$</span><input type="text" name="valor" inputmode="decimal" autocomplete="off" placeholder="0,00" value="<%= @amount %>" pattern="[0-9.]*[0-9](,[0-9]{1,2})?" required data-echo="nf-amount"></span>
          </label>
          <label class="field">
            <span class="field__label">Arquivo da NF</span>
            <input type="file" name="file" accept="application/pdf,image/jpeg,image/png,image/webp" required>
          </label>
          <div class="actions">
            <button type="button" class="button button--primary" data-confirm="confirm-nf">Enviar NF</button>
            <noscript><button type="submit" class="button button--primary">Confirmar envio</button></noscript>
          </div>
          <dialog id="confirm-nf" class="confirm" aria-labelledby="confirm-nf-title">
            <h3 id="confirm-nf-title">Confirmar envio</h3>
            <p>Enviar a NF de <%= competence_label(@competence) %> com valor total de <strong>R$ <span data-echo-target="nf-amount"></span></strong>? O total calculado é <%= money(close["expectedTotalCents"]) %>.</p>
            <div class="actions">
              <button type="submit" class="button button--primary">Confirmar envio</button>
              <button type="button" class="button" data-close>Voltar</button>
            </div>
          </dialog>
        </form>
      <% _ -> %>
      <% end %>
    </div>
  <% end %>
</section>
