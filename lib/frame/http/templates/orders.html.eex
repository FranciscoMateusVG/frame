<section>
  <div class="heading">
    <h1>Pedidos</h1>
    <form method="get" action="/orders" class="filters">
      <label class="field field--inline">
        <span class="field__label">Status</span>
        <select name="status">
          <option value="">Todos</option>
          <%= for {value, label} <- statuses() do %><option value="<%= value %>"<%= if value == @status do %> selected<% end %>><%= label %></option>
          <% end %>
        </select>
      </label>
      <button type="submit" class="button">Atualizar</button>
    </form>
  </div>

  <%= case @result do %>
  <% :unavailable -> %>
    <div class="notice notice--error" role="alert">
      <p>Não foi possível consultar os pedidos agora. O sistema do Incluir não respondeu.</p>
      <p><a class="button" href="<%= orders_href(@status, @cursor, @back) %>">Consultar novamente</a></p>
    </div>
  <% :invalid_cursor -> %>
    <div class="notice notice--error" role="alert">
      <p>Esta página da lista não vale mais.</p>
      <p><a class="button" href="<%= orders_href(@status, nil, []) %>">Voltar ao início da lista</a></p>
    </div>
  <% {:ok, [], _next} -> %>
    <div class="empty">
      <p class="empty__title">Nenhum pedido<%= if @status do %> com status “<%= status_label(@status) %>”<% end %>.</p>
      <p>Pedidos aprovados pelo Financeiro aparecem aqui sozinhos. Use Atualizar para consultar de novo.</p>
    </div>
  <% {:ok, items, next} -> %>
    <table class="orders">
      <thead><tr><th scope="col">Pedido</th><th scope="col">Título</th><th scope="col">Situação</th><th scope="col">Criado em</th><th scope="col"><span class="visually-hidden">Ação</span></th></tr></thead>
      <tbody>
      <%= for o <- items do %>
        <tr>
          <td class="orders__ref" data-label="Pedido"><%= o["reference"] %></td>
          <td data-label="Título"><%= o["title"] %></td>
          <td data-label="Situação"><span class="status status--<%= o["status"] %>"><%= status_label(o["status"]) %></span></td>
          <td data-label="Criado em"><%= local_time(o["createdAt"]) %></td>
          <td class="orders__action"><a class="button button--small" href="/orders/<%= o["id"] %>">Ver pedido</a></td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <nav class="pager" aria-label="Paginação">
      <%= if prev = previous_href(@status, @cursor, @back) do %><a class="button" href="<%= prev %>">Anterior</a><% else %><span class="button" aria-disabled="true">Anterior</span><% end %>
      <%= if href = next_href(@status, next, @cursor, @back) do %><a class="button" href="<%= href %>">Próxima</a><% else %><span class="button" aria-disabled="true">Próxima</span><% end %>
    </nav>
  <% end %>
</section>
