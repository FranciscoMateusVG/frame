# Print-shop portal — runtime environment (names only; values live in the
# deploy secret store, never in the repository).

# Shared supplier password, at least 12 characters.
PRINT_PORTAL_PASSWORD=
# Service token for /api/print-portal/v1 (server-only; Incluir stores its SHA-256).
INCLUIR_PRINT_SERVICE_TOKEN=
# Hono origin of this environment, e.g. http://hono-app:3000 (internal network).
INCLUIR_PRINT_API_ORIGIN=
# Exact public origin the browser sends, e.g. https://grafica.programaincluir.org
PRINT_PORTAL_ORIGIN=
# Optional
PORT=4000
# Comma-separated CIDRs of the reverse proxy (Traefik) whose X-Forwarded-For is trusted.
PRINT_PORTAL_TRUSTED_PROXIES=
